## Respec price: this much gold per point spent.
const RESPEC_GOLD_PER_POINT := 20


static func get_tree(id: String) -> Dictionary:
	var tree: Dictionary = TREES.get(id, {})
	return tree


static func get_node(id: String) -> Dictionary:
	var node: Dictionary = NODES.get(id, {})
	return node


## Node ids of one tree, ordered by tier, then column, then id.
static func tree_nodes(tree_id: String) -> Array[String]:
	var ids: Array[String] = []
	for id: String in NODES:
		if str(NODES[id].get("tree", "")) == tree_id:
			ids.append(id)
	ids.sort_custom(_sort_nodes)
	return ids


## Tree ids a player may see: the shared ones plus the chosen vocation's.
static func trees_for(vocation: String) -> Array[String]:
	var ids: Array[String] = []
	for id: String in TREE_ORDER:
		var owner := str(TREES[id].get("vocation", ""))
		if owner.is_empty() or owner == vocation:
			ids.append(id)
	return ids


static func _sort_nodes(a: String, b: String) -> bool:
	var node_a: Dictionary = NODES[a]
	var node_b: Dictionary = NODES[b]
	if int(node_a["tier"]) != int(node_b["tier"]):
		return int(node_a["tier"]) < int(node_b["tier"])
	if int(node_a["col"]) != int(node_b["col"]):
		return int(node_a["col"]) < int(node_b["col"])
	return a < b


## "+8% harvest speed" style summary of an `effects` dictionary, per rank.
static func effect_text(effects: Dictionary) -> String:
	var parts: Array[String] = []
	for stat: String in effects:
		var value := float(effects[stat])
		match stat:
			"max_hp": parts.append("+%d health" % int(value))
			"max_stamina": parts.append("+%d stamina" % int(value))
			"stamina_regen": parts.append("+%d stamina regeneration" % int(value))
			"walk_speed": parts.append("+%.1f walk speed" % value)
			"sprint_speed": parts.append("+%.1f run speed" % value)
			"damage_mult": parts.append("+%d%% damage" % roundi(value * 100.0))
			"crit_chance": parts.append("+%d%% critical chance" % roundi(value * 100.0))
			"gather_speed": parts.append("+%d%% harvest speed" % roundi(value * 100.0))
			"gather_yield_chance": parts.append("+%d%% chance of an extra mushroom" % roundi(value * 100.0))
			"craft_speed": parts.append("+%d%% brewing speed" % roundi(value * 100.0))
			"craft_save_chance": parts.append("+%d%% chance to keep an ingredient" % roundi(value * 100.0))
			"craft_bonus_chance": parts.append("+%d%% chance of an extra potion" % roundi(value * 100.0))
			"potion_potency": parts.append("+%d%% potion strength" % roundi(value * 100.0))
			_: parts.append("%s %+.2f" % [stat, value])
	return ", ".join(parts)
