# --- Toolchain (never commit the engine binary, ~180 MB) ---------------------
Godot Engine Latest/

# --- Godot editor cache ------------------------------------------------------
.godot/

# --- Export output (~250 MB) -------------------------------------------------
build/

# --- Test run artifacts ------------------------------------------------------
tests/_net_*.log
# In-engine captures are regenerated by tests/capture_frame.gd; the PNGs
# reviewers should see live in docs/screenshots/ instead.
tests/_capture*.png
tests/_capture*.png.import

# --- Documentation screenshots -----------------------------------------------
# Committed as images only; nothing in the game references them, so Godot
# regenerates their import descriptors locally and they would only churn.
docs/screenshots/*.import

# --- Model artefacts ---------------------------------------------------------
# The .gltf embeds its own texture and the editable sources live in
# assets/models/source/, so the loose Blockbench texture exports that land next
# to the exports are duplicates, and so are their import descriptors.
# player2.bbmodel is an abandoned variant and models.rar is an archive of the
# same files. Nothing under assets/models/source/ is affected.
assets/models/*_tex*.png
assets/models/*_tex*.png.import
assets/models/player2.bbmodel
assets/models/*.rar

# --- Scratch files -----------------------------------------------------------
*.tmp
# Claude/input bundles: applied to the tree, never source.
/files.zip
/files(1).zip

# --- OS junk -----------------------------------------------------------------
Thumbs.db
.DS_Store
desktop.ini

# NOTE: *.import and *.uid are deliberately NOT ignored. Godot needs both:
# .import descriptors for every imported asset and .uid sidecars since 4.4.
