[ext_resource type="PackedScene" path="res://scenes/ui/plot_board.tscn" id="13_board"]

[node name="Main" type="Node3D" groups=["main"]]
script = ExtResource("1_main")

[node name="World" parent="." instance=ExtResource("2_world")]

[node name="Players" type="Node3D" parent="."]

[node name="PlayerSpawner" type="MultiplayerSpawner" parent="."]
spawn_path = NodePath("../Players")
spawn_limit = 32

[node name="Enemies" type="Node3D" parent="."]

[node name="EnemySpawner" type="MultiplayerSpawner" parent="."]
spawn_path = NodePath("../Enemies")
spawn_limit = 32

[node name="HUD" parent="." instance=ExtResource("3_hud")]

[node name="InventoryUI" parent="." instance=ExtResource("4_inventory")]

[node name="ChatUI" parent="." instance=ExtResource("5_chat")]

[node name="PlotSystem" type="Node3D" parent="."]
script = ExtResource("6_plots")

[node name="BuildMode" parent="." instance=ExtResource("7_build")]

[node name="VocationUI" parent="." instance=ExtResource("8_vocation")]

[node name="PauseMenu" parent="." instance=ExtResource("9_pause")]

[node name="ShopUI" parent="." instance=ExtResource("10_shop")]

[node name="AlchemyUI" parent="." instance=ExtResource("11_alchemy")]

[node name="RepairUI" parent="." instance=ExtResource("12_repair")]

[node name="PlotBoardUI" parent="." instance=ExtResource("13_board")]
